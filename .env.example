# Copy to .env.local (git-ignored) for local development, or set the same
# variable in Vercel -> Project -> Settings -> Environment Variables.
# Vite only exposes variables prefixed with VITE_ to browser code, so NEVER put
# secrets here. This value ends up in the public JavaScript bundle by design.

# Public contact address shown on the Contact & Feedback page.
# Leave empty to show a "not configured" message instead.
VITE_CONTACT_EMAIL=
