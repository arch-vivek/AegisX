{
  "name": "aegisx",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:secure": "node scripts/serve-secure.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "test:server": "node --test scripts/serve-secure.test.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run lint && npm test && npm run build && npm run test:server && npm run test:browser && npm run audit:prod",
    "test:browser": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "jsdom": "^30.1.1",
    "oxlint": "^1.81.0",
    "puppeteer": "^25.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "description": "AegisX: citizen digital-safety and cyber fraud awareness tool (independent project, My Bharat Hackathon)",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
